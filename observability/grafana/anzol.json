    {
      "type": "timeseries",
      "title": "Capturas/s por método e status",
      "description": "Mensagens recebidas pelas URLs, pelo método e pela classe do status que a URL respondeu (none: a regra derrubou a conexão). 5xx aqui é resposta configurada (status no caminho, default_status ou regra), não erro do app: esse está em 'Erros HTTP 5xx do app (fora as respostas configuradas)'. O clique abre os traces das capturas do método.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (method, status_class) (rate(anzol_requests_captured_total{job=\"anzol\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{method}} · {{status_class}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 11,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Traces das capturas ${__field.labels.method}",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&panes={%22tempo%22:{%22datasource%22:%22${DS_TEMPO}%22%2C%22queries%22:%5B{%22refId%22:%22A%22%2C%22datasource%22:{%22type%22:%22tempo%22%2C%22uid%22:%22${DS_TEMPO}%22}%2C%22queryType%22:%22traceql%22%2C%22query%22:%22{resource.service.name%3D%5C%22anzol%5C%22%20%26%26%20resource.service.instance.id%3D~%5C%22$instance%5C%22%20%26%26%20span.anzol.token%21%3D%5C%22%5C%22%20%26%26%20span.method%3D%5C%22${__field.labels.method}%5C%22}%22%2C%22limit%22:20%2C%22filters%22:%5B%5D}%5D%2C%22range%22:{%22from%22:%22${__from}%22%2C%22to%22:%22${__to}%22}}}"
            }
          ]
        },
