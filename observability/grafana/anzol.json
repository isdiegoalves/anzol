        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Latência da captura p50/p95/p99 (sem esperas programadas)",
      "description": "Do recebimento até a resposta, descontados o timeout da URL e o delay/dribble da regra: é o tempo gasto pelo app (Redis, regras, template). Normal: milissegundos. p99 subindo sem subir 'Capturas/s por método e status' aponta o Redis: abra os traces e veja os spans filhos.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(anzol_capture_duration_seconds_bucket{job=\"anzol\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(anzol_capture_duration_seconds_bucket{job=\"anzol\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(anzol_capture_duration_seconds_bucket{job=\"anzol\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "editorMode": "code"
        }
      ],
